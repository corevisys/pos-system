# ============================================================
# CorevisysPOS .env.example
# -------------------------
# Copy this file to .env and fill in YOUR OWN values.
# This file is committed to the repo as the setup reference.
# NEVER put real credentials in .env.example or commit .env.
# ============================================================

APP_NAME=CorevisysPOS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Sales: enforce server-side grand_total validation on POS & Add Sale.
# true  = reject (HTTP 422) sales whose client grand_total mismatches the
#         server recompute (>0.01 rounding tolerance).
# false = log-only: still recompute + log mismatches, but trust the client
#         total (pre-validation behavior). Kill-switch for emergencies.
ENFORCE_TOTAL_VALIDATION=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravelpos
DB_USERNAME=root
DB_PASSWORD=
# DB_URL=
# DB_SOCKET=
# DB_CHARSET=utf8mb4
# DB_COLLATION=utf8mb4_unicode_ci
# DB_FOREIGN_KEYS=true
# DB_SSLMODE=prefer

# ------------------------------------------------------------
# Session / Cache / Queue
# ------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=
SESSION_EXPIRE_ON_CLOSE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# DB_QUEUE_CONNECTION=
# DB_QUEUE_TABLE=jobs
# QUEUE_FAILED_DRIVER=database-uuids

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1
MEMCACHED_PORT=11211
# MEMCACHED_USERNAME=
# MEMCACHED_PASSWORD=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# REDIS_DB=0
# REDIS_CACHE_DB=1
# REDIS_USERNAME=

# ------------------------------------------------------------
# Mail / SMTP  (fill with your real SMTP provider values)
# ------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# MAIL_URL=
# MAIL_EHLO_DOMAIN=
# MAIL_SENDMAIL_PATH=/usr/sbin/sendmail -bs -i

# ------------------------------------------------------------
# AWS / S3 (only if you use S3-backed storage)
# ------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
# AWS_URL=
# AWS_ENDPOINT=

# ------------------------------------------------------------
# Third-party service keys (fill only if you enable these)
# ------------------------------------------------------------
# POSTMARK_API_KEY=
# RESEND_API_KEY=
# SLACK_BOT_USER_OAUTH_TOKEN=
# SLACK_BOT_USER_DEFAULT_CHANNEL=

# ------------------------------------------------------------
# Payment gateways & SMS
# NOTE: This app stores Stripe / PayPal / Instamojo / Twilio /
#       SMS-API credentials in the DATABASE (db_stripe, db_paypal,
#       db_instamojo, db_twilio, db_smsapi tables) via the Settings UI,
#       NOT in .env. Leave the vars below empty / commented unless a
#       future release moves them to env-based configuration.
# ------------------------------------------------------------
# STRIPE_KEY=
# STRIPE_SECRET=
# STRIPE_WEBHOOK_SECRET=
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_MODE=sandbox
# INSTAMOJO_API_KEY=
# INSTAMOJO_AUTH_TOKEN=
# INSTAMOJO_SANDBOX=true
# TWILIO_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# SMS_API_KEY=
# SMS_SENDER_ID=

# ------------------------------------------------------------
# Local tooling paths (Windows dev only)
# ------------------------------------------------------------
WKHTML_PDF_BINARY=""
DUMP_BINARY_PATH=""

# ------------------------------------------------------------
# Misc
# ------------------------------------------------------------
# FORCE_HTTPS=false
# BACKUP_ARCHIVE_PASSWORD=
# AUTH_GUARD=web
# AUTH_PASSWORD_BROKER=users

VITE_APP_NAME="${APP_NAME}"
